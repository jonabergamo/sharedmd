{
  "name": "@sharedmd/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@sharedmd/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.0",
    "lib0": "^0.2.100",
    "socket.io": "^4.8.3",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0"
  }
}
